builds/
exports/
*.exe
*.dll
*.so
*.dylib
*.apk
*.ipa
*.zip

# IDE-specific
.vscode/
.idea/
*.sublime-workspace
*.sublime-project

# Custom level storage (don't commit user-created levels to repo)
levels/custom/*
!levels/custom/.gitkeep

# User settings
*.cfg
!export_presets.cfg
user://

# Temporary files
*.tmp
*.log
*.bak
